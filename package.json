{
  "name": "workchain-web",
  "description": "Decentralized labor record and reactive settlement platform.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "npx playwright install",
    "dev": "vite",
    "tauri": "tauri dev",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build": "tauri build",
    "build.all": "pnpm run build && pnpm run build.storybook",
    "build.web": "tsc -b && vite build",
    "build.review": "pnpm run build.web && pnpm run build.storybook",
    "build.storybook": "storybook build",
    "i18n": "tsx scripts/i18n-check.ts",
    "svg-imports": "tsx scripts/generate-svg-imports.ts",
    "svg-variant": "tsx scripts/generate-svg-variant-imports.ts",
    "format": "prettier --write . && vite-node scripts/license.ts",
    "review": "prettier --check . && oxlint && node scripts/license.ts -c",
    "license:update": "node scripts/license.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
