    "react-markdown": "^10.1.0",
    "react-responsive": "^10.0.1",
    "react-router": "^7.10.1",
    "react-select": "^5.10.2",
    "react-toastify": "^11.0.5",
    "styled-components": "^6.1.19",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
